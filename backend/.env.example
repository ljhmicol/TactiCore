# backend/.env 로 복사해서 사용한다 (.env 는 Git에 커밋하지 않음)
#
# DATABASE_URL은 보통 지정하지 않는다. 지정하지 않으면 프로젝트 루트의
# data/tacticore.db 를 절대 경로로 가리킨다 (config.py).
# 컨테이너에서는 /app/data 가 호스트의 ./data 로 마운트된다.
# DATABASE_URL=sqlite:///C:/work_dir/soccer/data/tacticore.db

CORS_ORIGINS=http://localhost:5173
APP_VERSION=1.0.0
